# Server-side state that composer/artisan create at runtime — never
# tracked on the deploy branch, so `git pull`/`git reset` never touches it.
/vendor
/.env
/.env.production
/storage
# public/storage is real-user-upload runtime state EXCEPT the demo/ seed
# images below, which are static content this script ships deliberately.
/public/storage/*
!/public/storage/demo/
/public/hot
/bootstrap/cache/*.php
